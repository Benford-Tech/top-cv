# Fournisseur de données LinkedIn utilisé par /api/linkedin (recherche par URL
# de profil). Sans ces variables, l'endpoint répond 501 et l'interface bascule
# sur l'import de l'archive d'export, qui ne dépend d'aucun service tiers.
#
# Aucun fournisseur n'est privilégié : le marché bouge vite — Proxycurl, qui en
# était la référence, a fermé en juillet 2026 après une action en justice de
# LinkedIn. Vérifiez les conditions et la conformité RGPD de celui que vous
# retenez avant de le brancher.

# Endpoint du fournisseur, sans le paramètre d'URL de profil
LINKEDIN_API_URL=

# Clé d'API. Elle reste côté serveur : elle n'est jamais exposée au navigateur.
LINKEDIN_API_KEY=

# Nom du paramètre de requête portant l'URL du profil (défaut : linkedin_profile_url)
# LINKEDIN_API_PARAM=linkedin_profile_url

# En-tête d'authentification et son préfixe (défauts : Authorization / "Bearer ")
# Exemple pour un fournisseur attendant une clé brute :
#   LINKEDIN_API_AUTH_HEADER=X-Api-Key
#   LINKEDIN_API_AUTH_PREFIX=
# LINKEDIN_API_AUTH_HEADER=Authorization
# LINKEDIN_API_AUTH_PREFIX=Bearer
