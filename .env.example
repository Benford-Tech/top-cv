# --- Import LinkedIn par URL (facultatif) -----------------------------------
# Ces variables activent la recherche par adresse de profil. Sans elles,
# l'endpoint répond 501 et l'interface bascule sur l'import de l'archive
# d'export, qui ne dépend d'aucun service tiers et reste la seule voie
# garantissant les recommandations.
#
# LinkedIn ne vend pas cet accès : il faut passer par un prestataire qui
# récupère le profil public. Le marché est instable — Proxycurl, longtemps la
# référence, a fermé en juillet 2026 après une action de LinkedIn. Vérifiez les
# conditions d'utilisation et la conformité RGPD de celui que vous retenez.

# Endpoint du fournisseur, sans le paramètre portant l'URL de profil.
LINKEDIN_API_URL=
LINKEDIN_API_KEY=

# Nom du paramètre de requête portant l'URL du profil (défaut :
# linkedin_profile_url).
# LINKEDIN_API_PARAM=linkedin_profile_url

# Deux conventions d'authentification existent ; renseignez celle du
# fournisseur choisi.
#
# a) Clé en paramètre d'URL — renseignez LINKEDIN_API_KEY_PARAM.
#    Exemple pour ScrapIn (https://api.scrapin.io) :
#      LINKEDIN_API_URL=https://api.scrapin.io/enrichment/profile
#      LINKEDIN_API_PARAM=linkedinUrl
#      LINKEDIN_API_KEY_PARAM=apikey
# LINKEDIN_API_KEY_PARAM=

# b) Clé en en-tête (comportement par défaut : « Authorization: Bearer <clé> »).
#    Pour un fournisseur attendant une clé brute dans un en-tête dédié :
#      LINKEDIN_API_AUTH_HEADER=X-Api-Key
#      LINKEDIN_API_AUTH_PREFIX=
# LINKEDIN_API_AUTH_HEADER=Authorization
# LINKEDIN_API_AUTH_PREFIX=Bearer

# --- Comptes et base de données (Supabase) ---------------------------------
# Sans ces variables, l'application reste utilisable en brouillon local mais
# aucun téléchargement n'est possible : le PDF n'existe que côté serveur.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Mêmes valeurs, lues par les fonctions serveur
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé de service : contourne RLS. Utilisée uniquement par le webhook Stripe,
# seul endroit habilité à débloquer un CV. Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
# Secret de signature du webhook. Sans lui, aucun déblocage n'est accepté.
STRIPE_WEBHOOK_SECRET=
# Prix : soit un identifiant de tarif Stripe, soit un montant en centimes.
# STRIPE_PRICE_ID=
CV_PRICE_CENTS=490
CV_PRICE_CURRENCY=eur

# --- Rendu PDF --------------------------------------------------------------
# En développement seulement : chemin d'un Chromium local. En production, le
# binaire embarqué (@sparticuz/chromium) est utilisé automatiquement.
# CHROMIUM_PATH=/usr/bin/chromium

# --- Référencement ----------------------------------------------------------
# Adresse publique du site, utilisée pour les balises Open Graph, l'URL
# canonique et le plan du site. Ces éléments exigent des URL absolues.
SITE_URL=https://votre-domaine.fr
